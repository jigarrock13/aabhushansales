<section class="as-collection">
  <div class="as-collection-header">
    <p class="as-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="as-collection-intro">{{ collection.description }}</div>
    {%- else -%}
      <p class="as-collection-intro">{{ section.settings.fallback_text }}</p>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="as-product-grid">
        {%- for product in collection.products -%}
          {% render 'aabhushan-product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="as-heading"><h2>{{ section.settings.empty_heading }}</h2><p>{{ section.settings.empty_text }}</p></div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Aabhushan collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "textarea", "id": "fallback_text", "label": "Fallback collection text", "default": "Explore micro imitation jewellery, fashion accessories, gifts, and occasion-ready styles from Aabhushan Sales." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "This collection is being updated" },
    { "type": "textarea", "id": "empty_text", "label": "Empty text", "default": "Please contact the store for current availability while this catalogue is refreshed." }
  ],
  "presets": [ { "name": "Aabhushan collection" } ]
}
{% endschema %}
